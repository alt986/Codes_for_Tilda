<!-- Кастомный прелоадер с процентами -->
<div class="uc-preloader">
    <div class="loader-content">
        <div class="progress-bar"></div>
        <div class="percentage">0%</div>
    </div>
</div>

<script>
(function() {
    const normalTime = 2600; // Основное время работы (мс)
    const spareTime = 3000; // Аварийное время работы (мс)
    
    let progress = 0;
    const body = document.body;
    body.style.overflow = "hidden";
    
    const preloader = document.querySelector('.uc-preloader');
    const progressBar = document.querySelector('.progress-bar');
    const percentage = document.querySelector('.percentage');
    
    if(preloader != null) {
        function updateProgress() {
            progress += 1;
            progressBar.style.width = progress + '%';
            percentage.textContent = progress + '%';
            
            if(progress >= 100) {
                clearInterval(interval);
                preloader.classList.add('hide-preloader');
                body.style.overflow = "";
                window.dispatchEvent(new Event('resize'));
            }
        }
        
        const interval = setInterval(updateProgress, 25);
        
        document.addEventListener("DOMContentLoaded", function() {
            setTimeout(function() {
                preloader.classList.add('hide-preloader');
                body.style.overflow = "";
                window.dispatchEvent(new Event('resize'));
            }, spareTime);
        });
        
        window.onload = () => {
            setTimeout(function() {
                preloader.classList.add('hide-preloader');
                body.style.overflow = "";
                window.dispatchEvent(new Event('resize'));
            }, normalTime);
        };
    }
})();
</script>

<style>
.uc-preloader {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 100005;
    background: #ffffff; /* Цвет фона прелоадера */
    display: flex;
    justify-content: center;
    align-items: center;
}

.loader-content {
    text-align: center;
}

.progress-bar {
    width: 0%;
    height: 10px;
    background: #007bff; /* Цвет прогресс бара */
    border-radius: 5px;
    transition: width 0.1s ease;
}

.percentage {
    margin-top: 10px;
    font-size: 24px;
    color: #333;
}

.hide-preloader {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.75s ease-in-out 0.35s;
}
</style>
